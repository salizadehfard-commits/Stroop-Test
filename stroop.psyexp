        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="corrData = trialmain.data[&quot;main_keyboard.corr&quot;];&amp;#10;rtData = trialmain.data[&quot;main_keyboard.rt&quot;];&amp;#10;nCorrect = util.sum(corrData);&amp;#10;nTrials = corrData.length;&amp;#10;nWrong = (nTrials - nCorrect);&amp;#10;accuracy = ((nCorrect / nTrials) * 100);&amp;#10;meanRT = (util.sum(rtData) / rtData.length);&amp;#10;feedbackText = (((((((((((&quot;\u0646\u062a\u06cc\u062c\u0647 \u0646\u0647\u0627\u06cc\u06cc \u0622\u0632\u0645\u0648\u0646 \u0627\u0633\u062a\u0631\u0648\u067e\n\n&quot; + &quot;\u062a\u0639\u062f\u0627\u062f \u067e\u0627\u0633\u062e \u0635\u062d\u06cc\u062d: &quot;) + nCorrect.toString()) + &quot;\n\n\u062a\u0639\u062f\u0627\u062f \u067e\u0627\u0633\u062e \u063a\u0644\u0637: &quot;) + nWrong.toString()) + &quot;\n\n\u062f\u0631\u0635\u062f \u0635\u062d\u062a: &quot;) + util.round(accuracy, 1).toString()) + &quot;%&quot;) + &quot;\n\n\u0645\u06cc\u0627\u0646\u06af\u06cc\u0646 \u0632\u0645\u0627\u0646 \u0648\u0627\u06a9\u0646\u0634: &quot;) + util.round((meanRT * 1000), 0).toString()) + &quot; \u0645\u06cc\u0644\u06cc\u200c\u062b\u0627\u0646\u06cc\u0647&quot;) + &quot;\n\n\u0628\u0631\u0627\u06cc \u062e\u0631\u0648\u062c \u06a9\u0644\u06cc\u062f \u0641\u0627\u0635\u0644\u0647 \u0631\u0627 \u0641\u0634\u0627\u0631 \u062f\u0647\u06cc\u062f&quot;);&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="corrData = trialmain.data['main_keyboard.corr']&amp;#10;rtData = trialmain.data['main_keyboard.rt']&amp;#10;&amp;#10;nCorrect = sum(corrData)&amp;#10;nTrials = len(corrData)&amp;#10;&amp;#10;nWrong = nTrials - nCorrect&amp;#10;&amp;#10;accuracy = (nCorrect / nTrials) * 100&amp;#10;&amp;#10;meanRT = sum(rtData) / len(rtData)&amp;#10;&amp;#10;feedbackText = (&amp;#10;    &quot;نتیجه نهایی آزمون استروپ\n\n&quot;&amp;#10;    + &quot;تعداد پاسخ صحیح: &quot; + str(nCorrect)&amp;#10;    + &quot;\n\nتعداد پاسخ غلط: &quot; + str(nWrong)&amp;#10;    + &quot;\n\nدرصد صحت: &quot; + str(round(accuracy,1)) + &quot;%&quot;&amp;#10;    + &quot;\n\nمیانگین زمان واکنش: &quot;&amp;#10;    + str(round(meanRT*1000,0))&amp;#10;    + &quot; میلی‌ثانیه&quot;&amp;#10;    + &quot;\n\nبرای خروج کلید فاصله را فشار دهید&quot;&amp;#10;)" valType="extendedCode" updates="constant" name="Begin Routine"/>
